<script>
(()=>{
const S=[["Commit","git push origin main"],["Build","Maven, image Docker multi-stage"],["Tests","JUnit, Testcontainers"],["Qualité","Analyse SonarQube"],["Sécurité","Scan Trivy"],["Publication","Image envoyée sur DockerHub"],["Déploiement","Rollout Kubernetes sur AKS"]];
const box=document.getElementById('stages'),log=document.getElementById('log'),btn=document.getElementById('push');
box.innerHTML=S.map(s=>`<div class="st"><i>✓</i><span>${s[0]}</span><small>${s[1]}</small></div>`).join('');
const el=[...box.children];let timers=[];
const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
function run(){timers.forEach(clearTimeout);timers=[];el.forEach(e=>e.className='st');log.className='live go';log.textContent='Pipeline lancé...';
if(reduce){el.forEach(e=>e.classList.add('ok'));log.textContent='Application en ligne.';return}
el.forEach((e,i)=>{timers.push(setTimeout(()=>{if(i)el[i-1].className='st ok';e.className='st run';log.textContent='> '+S[i][0].toLowerCase()+' : '+S[i][1]},i*900+300))});
timers.push(setTimeout(()=>{el[el.length-1].className='st ok';log.textContent='Application en ligne. Prêt pour la prochaine livraison.'},S.length*900+600));
timers.push(setTimeout(run,S.length*900+7000))}
btn.onclick=run;run();
document.querySelectorAll('.proj').forEach(p=>p.addEventListener('pointermove',e=>{const r=p.getBoundingClientRect();p.style.setProperty('--mx',e.clientX-r.left+'px');p.style.setProperty('--my',e.clientY-r.top+'px')}));
const lb=document.getElementById('lb');
document.querySelectorAll('.cert').forEach(c=>c.addEventListener('click',()=>{if(c.classList.contains('missing'))return;lb.querySelector('img').src=c.dataset.src;lb.showModal()}));
lb.addEventListener('click',e=>{if(e.target!==lb.querySelector('img'))lb.close()});
})();
</script>
